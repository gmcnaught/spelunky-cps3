# Host build of the level generator and its harness (tools/gencmp.py compares with the HD runner's dumps).
#   make -C test/host            -> build/host/genhost
#   make -C test/host sh2        -> compile check of src/game (and src/sh2/fma.c, pcol.c's fmaf: the SH-2 has no
#                                   libm) with sh-elf-gcc -m2 (if installed); -fno-bit-tests:
#                                   GCC turns large switches into variable shifts (libgcc ___ashlsi3) otherwise
ROOT := $(abspath ../..)
GEN := $(ROOT)/build/gen
OUT := $(ROOT)/build/host
SRC := $(ROOT)/src/game/rng.c $(ROOT)/src/game/inst.c $(ROOT)/src/game/gen.c $(ROOT)/src/game/genroom.c \
       $(ROOT)/src/game/genobj.c $(ROOT)/src/game/genent.c $(GEN)/objects.c $(GEN)/gentables.c
CFLAGS ?= -std=c99 -O2 -Wall -Wextra -Wno-unused-parameter
INC := -I$(ROOT)/src/game -I$(GEN) -I$(ROOT)/../cps3-testgame/sdk/include -I$(ROOT)/build/snd -DSND_LOG

PSRC := $(ROOT)/src/game/pworld.c $(ROOT)/src/game/pscript.c $(ROOT)/src/game/pobj.c $(ROOT)/src/game/pplayer.c \
        $(ROOT)/src/game/prun.c $(ROOT)/src/game/pcol.c $(ROOT)/src/game/ptrans.c $(GEN)/playtables.c \
        $(ROOT)/src/game/penemy.c $(ROOT)/src/game/pdamsel.c $(ROOT)/src/game/pshop.c $(ROOT)/src/game/pmath.c \
        $(ROOT)/src/game/pitem.c $(ROOT)/src/game/pmsg.c $(ROOT)/src/snd/snd.c
# host only (stdio): the SDK voice stubs and the SND lines (not in the sh2 objects)
HSRC := sndhost.c

all: $(OUT)/genhost $(OUT)/playhost $(OUT)/playhost_fx $(OUT)/playhost_nc

$(GEN)/objects.h $(GEN)/objects.c:
	cd $(ROOT) && python3 tools/hdobjects.py refs/hd/src build/gen/objects.h

$(GEN)/gentables.h $(GEN)/gentables.c:
	cd $(ROOT) && python3 tools/hdgentables.py refs/hd/src refs/hd/linux-arm64/assets/game.unx build/gen/gentables.h

$(OUT)/genhost: genhost.c $(SRC) $(ROOT)/src/game/*.h $(GEN)/objects.h $(GEN)/gentables.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) $(INC) -o $@ genhost.c $(SRC)

# the sound assets' names (test/host/sndhost.c's SND lines: tools/sndcmp.py)
$(ROOT)/build/snd/sndnames.h: $(ROOT)/build/snd/snd.h
	python3 -c "import re,sys; t=open(sys.argv[1]).read(); e=t[t.index('enum snd'):t.index('SND_COUNT')]; n=re.findall(r'SND_(\w+),', e); open(sys.argv[2],'w').write('/* generated by test/host/Makefile */\nstatic const char *const sndnames[%d] = {%s};\n' % (len(n), ', '.join('\"%s\"' % x for x in n)))" $< $@

$(GEN)/playtables.h $(GEN)/playtables.c: $(GEN)/objects.h
	cd $(ROOT) && python3 tools/hdplaytables.py refs/hd/linux-arm64/assets/game.unx build/gen/playtables.h

# the play loop: binary64 (default) and s7.24 / s13.18 fixed point (-DPLAY_FIXED)
$(OUT)/playhost: playhost.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -DPLAY_STATS $(INC) -o $@ playhost.c $(SRC) $(PSRC) $(HSRC)

$(OUT)/playhost_fx: playhost.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -DPLAY_FIXED $(INC) -o $@ playhost.c $(SRC) $(PSRC) $(HSRC)

# binary64 with no floating-point contraction anywhere (clang on arm64 contracts a * b + c by default; the runner's
# fused operations are explicit fmaf calls in pcol.c): the routes must give the same records as playhost
#   PLAYHOST=build/host/playhost_nc scripts/p4_trace.sh <route> <seed> --no-run
$(OUT)/playhost_nc: playhost.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -DPLAY_STATS -ffp-contract=off $(INC) -o $@ playhost.c $(SRC) $(PSRC) $(HSRC)

# pcol.c's integer path of the R-tree area arithmetic against the float expressions (it includes pcol.c)
$(OUT)/pcolxv: pcolxv.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -ffp-contract=off $(INC) -o $@ pcolxv.c $(SRC) $(filter-out $(ROOT)/src/game/pcol.c,$(PSRC) $(HSRC)) -lm

# struct pin_ext checked (play.h PIN_EXT_CHECK): exits 3 when the shared record 0 (the terrain's defaults) was
# written or a removed instance's record is read; run it over the routes and generated levels
$(OUT)/playhost_extchk: playhost.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -DPLAY_STATS -DPIN_EXT_CHECK -ffp-contract=off $(INC) -o $@ playhost.c $(SRC) $(PSRC) $(HSRC)

# tools/colprobe.py's C side (the instance collision tests against the runner's)
$(OUT)/colprobe: colprobe.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -ffp-contract=off $(INC) -o $@ colprobe.c $(SRC) $(PSRC) $(HSRC)

# the play code with struct pin's collision fields const (play.h PIN_CONST_CHECK): a write that bypasses the
# pin_set* setters (and so the collision tree's dirty marks) is a compile error. Compile only (no binary)
constcheck: $(GEN)/objects.h $(GEN)/gentables.h $(GEN)/playtables.h
	for f in $(PSRC) playhost.c treeprobe.c; do $(CC) -std=c99 -fsyntax-only -Wall -Wno-unused-parameter -DPIN_CONST_CHECK $(INC) $$f || exit 1; done

# binary64 with its operations counted (the num class of pnum.h: -DPLAY_COUNT, everything compiled as C++)
$(OUT)/playhost_count: playhost.c $(SRC) $(PSRC) $(ROOT)/src/game/*.h $(GEN)/playtables.h $(ROOT)/build/snd/sndnames.h $(ROOT)/src/snd/snd.h
	mkdir -p $(OUT)
	$(CXX) -x c++ -std=c++17 -O2 -w -DPLAY_COUNT $(INC) -o $@ playhost.c $(SRC) $(PSRC) $(HSRC)

# the play loop in both arithmetic builds (binary64: GCC's soft-float; PLAY_FIXED: integers only)
sh2: $(GEN)/objects.h $(GEN)/gentables.h $(GEN)/playtables.h
	mkdir -p $(OUT)/sh2 $(OUT)/sh2fx
	for f in $(SRC) $(filter-out sndhost.c,$(PSRC)); do sh-elf-gcc -m2 -std=c99 -O2 -Wall -ffreestanding -fno-bit-tests -DPLAY_FIXED $(INC) -c $$f -o $(OUT)/sh2fx/$$(basename $$f .c).o || exit 1; done
	for f in $(SRC) $(filter-out sndhost.c,$(PSRC)); do sh-elf-gcc -m2 -std=c99 -O2 -Wall -ffreestanding -fno-bit-tests $(INC) -c $$f -o $(OUT)/sh2/$$(basename $$f .c).o || exit 1; done
	sh-elf-gcc -m2 -std=c99 -O2 -Wall -Wextra -ffreestanding -fno-bit-tests -c $(ROOT)/src/sh2/fma.c -o $(OUT)/sh2/fma.o

.PHONY: all sh2 constcheck
